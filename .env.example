# Copy this file to .env and fill in the values.
PORT=3000
DATABASE_URL=postgresql://laptertechnologies_g:<PASSWORD>@kind-crawler-26753.j77.aws-ap-south-1.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full
# Optional: enable Google sign-in integration once your credentials are ready.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# Set this to your production apex domain for tenant subdomains, e.g. schoolflow.com
# If omitted, Vercel will use the injected VERCEL_URL automatically.
APP_BASE_HOST=
# Vercel injects this automatically in production; leave it blank locally.
VERCEL_URL=
