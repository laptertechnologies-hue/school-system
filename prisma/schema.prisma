datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

model School {
  id           String    @id @default(uuid())
  name         String
  subdomain    String    @unique
  packageType  String    // "BASIC" (report cards), "PREMIUM" (report cards + finance)
  status       String    @default("PENDING") // PENDING, ACTIVE, INACTIVE
  schoolType   String    @default("COMBINED") // "PRIMARY", "SECONDARY", "COMBINED"
  studentRange String
  contactEmail String
  contactPhone String
  createdAt    DateTime  @default(now())
  expiresAt    DateTime?
  users        User[]
  classes      Class[]
  students     Student[]
  subjects     Subject[]
  examPapers   ExamPaper[]
  payments     Payment[]
  expenses     Expense[]
  feeStructures FeeStructure[]
  smsLogs      SmsLog[]
  smsCredits   SmsCredit[]

  schoolPayTransactions SchoolPayTransaction[]

  // Custom metadata fields
  logoUrl            String?
  poBox              String?
  headTeacher        String?
  deputyHeadTeacher  String?
  director           String?
  themeColor         String?   @default("#38bdf8")

  // SchoolPay Integration
  schoolPayCode      String?
  schoolPayPassword  String?
  currentTerm        Int       @default(1)
  currentYear        Int       @default(2026)

  // Term Date Ranges
  term1Start         DateTime?
  term1End           DateTime?
  term2Start         DateTime?
  term2End           DateTime?
  term3Start         DateTime?
  term3End           DateTime?

  // Custom report template config
  reportTitle        String?   @default("OFFICIAL ACADEMIC REPORT CARD")
  reportMotto        String?   @default("")
  reportShowBadge    Boolean   @default(true)
  reportShowResidency Boolean  @default(true)
  reportShowSignatures Boolean @default(true)
  reportShowRules    Boolean   @default(true)
  reportLogoSize      Int?      @default(60)
  reportShowStudentPhoto Boolean? @default(true)
  reportHeaderColor   String?   @default("#1e3a8a")
  reportBorderType    String?   @default("double")
  reportNextTermFeesDay Float?  @default(150000)
  reportNextTermFeesBoarding Float? @default(350000)
  cbU1Max            Float?    @default(3)
  cbU2Max            Float?    @default(3)
  cbEtMax            Float?    @default(3)
  cbHpgMax           Float?    @default(3)
  cbU1Active         Boolean?  @default(true)
  cbU2Active         Boolean?  @default(true)
  cbEtActive         Boolean?  @default(true)
  cbHpgActive        Boolean?  @default(true)
  reportTikTok       String?   @default("")
  reportWebsite      String?   @default("")
  reportLocation     String?   @default("")
  reportShowChart    Boolean?  @default(true)
  reportShowLIN      Boolean?  @default(true)
  reportShowPayCode  Boolean?  @default(true)
  reportShowComments Boolean?  @default(true)
  reportShowFees     Boolean?  @default(true)
  reportShowTermDates Boolean? @default(true)
  reportShowSummaryRow Boolean? @default(true)
  gradeRanges         GradeRange[]
}

model User {
  id           String    @id @default(uuid())
  schoolId     String
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name         String
  email        String
  passwordHash String
  role         String    // "ADMIN", "HEADTEACHER", "DIRECTOR", "DOS", "TEACHER"
  createdAt    DateTime  @default(now())
  photo        String?
  staffNumber  String?
  contact      String?   // Staff/Teacher phone number for SMS
  mustChangePassword Boolean @default(false)
  marksCreated Mark[]    @relation("MarkCreator")
  teacherSubjects TeacherSubject[]

  @@unique([schoolId, email])
}

model Class {
  id           String    @id @default(uuid())
  schoolId     String
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name         String    // e.g. "P1", "S4"
  level        String    // "PRIMARY", "SECONDARY"
  themeColor   String?   // Add theme color for class report cards
  themeTextColor String? // Add custom text color for class report cards
  streams      Stream[]
  students     Student[]
  subjects     Subject[]
  teacherSubjects TeacherSubject[]
  feeStructures FeeStructure[]
  examPapers   ExamPaper[]
}

model Stream {
  id           String    @id @default(uuid())
  classId      String
  class        Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  name         String    // e.g. "A", "B"
  students     Student[]
  teacherSubjects TeacherSubject[]
}

model Student {
  id               String    @id @default(uuid())
  schoolId         String
  school           School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId          String
  class            Class     @relation(fields: [classId], references: [id])
  streamId         String
  stream           Stream    @relation(fields: [streamId], references: [id])
  name             String
  studentNumber    String    // Unique inside the school
  type             String    // "DAY", "BOARDING"
  photo            String?
  lin              String?
  studentPaymentCode String? // Admin-assigned pay code (primary identifier for payments)
  registrationNumber String?
  gender             String?
  parentContact    String?   // Parent/Guardian phone number for SMS
  classTeacherComment String? // Custom class teacher comment
  headTeacherComment  String? // Custom head teacher comment
  marks            Mark[]
  studentPayments  StudentPayment[]
  attendances      Attendance[]

  @@unique([schoolId, studentNumber])
}

model Subject {
  id           String    @id @default(uuid())
  schoolId     String
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId      String
  class        Class     @relation(fields: [classId], references: [id])
  name         String    // e.g. "Mathematics"
  code         String?   // e.g. "MTC"
  marks        Mark[]
  teacherSubjects TeacherSubject[]
}

model TeacherSubject {
  id           String    @id @default(uuid())
  teacherId    String
  teacher      User      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subjectId    String
  subject      Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classId      String
  class        Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  streamId     String
  stream       Stream    @relation(fields: [streamId], references: [id], onDelete: Cascade)
}

model ExamPaper {
  id              String    @id @default(uuid())
  schoolId        String
  school          School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  term            Int       // 1, 2, 3
  year            Int
  name            String    // e.g., "Beginning of Term (BOT)", "Mid-Term (MOT)", "End of Term (EOT)"
  maxMarks        Float     @default(100)
  isNewCurriculum Boolean   @default(false) // If true, grades are letters/competency based
  classId         String?
  class           Class?    @relation(fields: [classId], references: [id], onDelete: Cascade)
  cbU1Active      Boolean   @default(true)
  cbU2Active      Boolean   @default(true)
  cbEtActive      Boolean   @default(true)
  cbHpgActive     Boolean   @default(true)
  cbU1Max         Float     @default(3)
  cbU2Max         Float     @default(3)
  cbEtMax         Float     @default(3)
  cbHpgMax        Float     @default(3)
  marks           Mark[]
}

model Mark {
  id              String    @id @default(uuid())
  studentId       String
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examPaperId     String
  examPaper       ExamPaper @relation(fields: [examPaperId], references: [id], onDelete: Cascade)
  subjectId       String
  subject         Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  score           Float     // Numeric score out of examPaper.maxMarks
  competencyGrade String?   // A, B, C, D, E (For secondary CBC) or computed PLE Aggregate grade (1-8)
  comments        String?
  u1              Float?
  u2              Float?
  u3              Float?
  hpg             Float?
  eoy             Float?
  createdAt       DateTime  @default(now())
  createdById     String
  createdBy       User      @relation("MarkCreator", fields: [createdById], references: [id])
}

model Payment {
  id           String    @id @default(uuid())
  schoolId     String
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  amount       Float
  method       String    // "MOBILE_MONEY", "BANK", "CASH", "CARD"
  status       String    // "PENDING", "COMPLETED", "FAILED"
  date         DateTime  @default(now())
  txRef        String?
}

model FeeStructure {
  id             String    @id @default(uuid())
  schoolId       String
  school         School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId        String
  class          Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  term           Int       // 1, 2, 3
  year           Int
  tuitionAmount  Float
  boardingAmount Float
}

model StudentPayment {
  id             String    @id @default(uuid())
  studentId      String
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term           Int
  year           Int
  amountPaid     Float
  balance        Float
  balanceBF      Float     @default(0) // Balance Brought Forward from previous term
  notes          String?   // Optional notes / receipt reference
  paymentMethod  String?   @default("CASH") // CASH, BANK, SCHOOL_PAY, MOBILE_MONEY
  receiptNumber  String?   // Manual or auto receipt number
  date           DateTime  @default(now())
}

model Expense {
  id           String    @id @default(uuid())
  schoolId     String
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  category     String
  amount       Float
  description  String
  date         DateTime  @default(now())
}

model Attendance {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  status    String   // "PRESENT", "ABSENT", "SICK"
  term      Int
  year      Int
}

model GradeRange {
  id               String   @id @default(uuid())
  schoolId         String
  school           School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  systemType       String   // "PRIMARY" or "SECONDARY"
  grade            String
  minMark          Float
  maxMark          Float
  achievementLevel String
  descriptor       String   @default("")
}

model SchoolPayTransaction {
  id                    String   @id @default(uuid())
  schoolId              String
  school                School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  receiptNumber         String   @unique
  amount                Float
  paymentDate           DateTime
  studentName           String
  studentPaymentCode    String
  settlementBankCode    String?
  sourceChannelTransId  String?
  sourcePaymentChannel  String?
  studentClass          String?
  studentRegistrationNum String?
  reconciled            Boolean  @default(false)
  createdAt             DateTime @default(now())
}

model SmsLog {
  id              String   @id @default(uuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sentById        String   // userId of sender
  sentByName      String
  audience        String   // "CLASS_PARENTS", "ALL_TEACHERS", "ALL"
  targetClassName String?  // e.g. "P1" when audience is CLASS_PARENTS
  message         String
  recipientCount  Int
  successCount    Int      @default(0)
  failedCount     Int      @default(0)
  totalCharged    Float    // 40 UGX × recipients × smsUnits
  profitCollected Float    // 10 UGX × recipients × smsUnits
  smsCost         Float    // 30 UGX × recipients × smsUnits
  payerPhone      String?
  marzPayRef      String?
  status          String   @default("PENDING") // PENDING, PAYMENT_CONFIRMED, SENT, FAILED
  creditUsed      Boolean  @default(false)
  createdAt       DateTime @default(now())
}

model SmsCredit {
  id           String   @id @default(uuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  creditsPurchased Int  // Total SMS credits bought (each credit = 1 SMS unit = 40 UGX)
  creditsUsed  Int      @default(0)
  marzPayRef   String?
  payerPhone   String?
  amountPaid   Float    // Total amount collected
  status       String   @default("PENDING") // PENDING, CONFIRMED
  purchasedAt  DateTime @default(now())
}
